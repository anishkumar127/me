# ── Site URL (required for correct SEO on custom domains) ──
# GitHub Pages user site:
# NEXT_PUBLIC_SITE_URL=https://anishkumar127.github.io
# Vercel / Cloudflare / custom domain:
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Subpath deploy only (e.g. github.io/repo-name) ──
# Production builds use .env.production (committed) for GitHub Pages (/me).
# For local dev, leave basePath unset so the site runs at http://localhost:3000
# NEXT_PUBLIC_BASE_PATH=/repo-name

# ── Search console verification (optional) ──
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code

# ── Analytics (optional) ──
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=anishkumar127.github.io
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
